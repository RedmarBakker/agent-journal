{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "judges": [
        "tests/stories"
    ],
    "find": {
        "reject": [
            {
                "file": "tests/stories/builder/**"
            },
            {
                "file": "tests/stories/fixtures/**"
            },
            {
                "file": "tests/stories/conftest.py"
            },
            {
                "file": "tests/stories/test_*.py"
            }
        ],
        "select": "kind:Assert",
        "where": [
            {
                "file": "tests/stories/**"
            }
        ]
    },
    "sin": {
        "description": "A story contains an assert statement.",
        "name": "story-assert",
        "rule": "Call an expect method of the story builder; keep the assert inside that method.",
        "skill": "tests-drive-the-real-path"
    }
}
