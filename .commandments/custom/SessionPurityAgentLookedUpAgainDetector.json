{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "of": "child:func",
                "all": [
                    {
                        "nameIn": [
                            "agent",
                            "session_agent",
                            "session_roles",
                            "matching"
                        ]
                    },
                    {
                        "of": "child:value",
                        "nameIn": [
                            "agents",
                            "sessions"
                        ]
                    }
                ]
            },
            {
                "argument": {
                    "at": 0,
                    "all": [
                        {
                            "is": "member-access"
                        },
                        {
                            "name": "session"
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "file": "src/journal/engine/support/session_agents.py"
            },
            {
                "file": "src/journal/repositories/agents.py"
            },
            {
                "file": "src/journal/http/controllers/hooks.py"
            },
            {
                "file": "src/journal/hooks/translation.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "session-purity-agent-looked-up-again",
        "description": "Code looks the agent up again from an event's or a hook's session, though the event was born knowing its agent.",
        "rule": "Read the agent the event carries, event.agent; it is found once where the event is born, and a listener that needs the newest row reads it fresh by a method named so.",
        "skill": "stack-machine"
    }
}
