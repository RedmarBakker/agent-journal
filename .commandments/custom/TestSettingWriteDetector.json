{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "judges": [
        "tests"
    ],
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "set"
                ]
            },
            {
                "of": "child:func",
                "all": [
                    {
                        "is": "member-access"
                    },
                    {
                        "of": "child:value",
                        "nameIn": [
                            "get"
                        ]
                    },
                    {
                        "of": "child:value",
                        "argument": {
                            "at": 0,
                            "nameIn": [
                                "SettingRows"
                            ]
                        }
                    }
                ]
            },
            {
                "fileMatches": "(^|/)tests/"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)tests/(full_project|test_data)\\.py$"
            },
            {
                "argument": {
                    "at": 0,
                    "textMatches": "^features\\."
                }
            }
        ]
    },
    "sin": {
        "name": "test-setting-write",
        "description": "A test writes an option's row directly instead of running settings set, so the option's parsing, its kind and who may set it are never run, and the test stays green when the command is broken; a feature's switch written as setup is left alone.",
        "rule": "Set it the way the user or the agent does: user_set(app, key, value) from tests/user_settings.py runs journal settings set through the console as the user.",
        "skill": "tests-drive-the-real-path"
    }
}
