{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "extendsAny": "Event"
            },
            {
                "not": {
                    "referredFrom": {
                        "any": [
                            {
                                "is": "parameter",
                                "of": "parent"
                            },
                            {
                                "kind": "Subscript",
                                "of": "parent"
                            },
                            {
                                "kind": "Tuple",
                                "of": "parent"
                            },
                            {
                                "kind": "Dict",
                                "of": "parent"
                            },
                            {
                                "inside": {
                                    "all": [
                                        {
                                            "is": "call"
                                        },
                                        {
                                            "nameIn": [
                                                "isinstance",
                                                "announce",
                                                "plugin_check"
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "reject": [
            {
                "referredFrom": {
                    "is": "type-declaration",
                    "of": "parent"
                }
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "unheard-event",
        "description": "An event class nothing hears: no Listener[...] of it, no on_ parameter typed with it, no isinstance check, no tuple or table of event types holding it and no announcement to the plugins, so whatever dispatches it reaches nobody.",
        "rule": "Hear it where its moment matters, as a listener or a state's on_ method, or remove the event and what dispatches it.",
        "skill": "stack-machine"
    }
}