{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "any": [
                    {
                        "name": "ScopeBinding"
                    },
                    {
                        "all": [
                            {
                                "nameIn": [
                                    "entered",
                                    "requested"
                                ]
                            },
                            {
                                "descendant": {
                                    "name": "scope"
                                }
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "file": "src/journal/hooks/receiver.py"
            },
            {
                "file": "src/journal/console/console.py"
            },
            {
                "file": "src/journal/http/router.py"
            },
            {
                "file": "src/journal/engine/state_machine.py"
            },
            {
                "file": "src/journal/repositories/scope.py"
            },
            {
                "file": "src/journal/repositories/scope_binding.py"
            },
            {
                "file": "tests/**"
            }
        ]
    },
    "sin": {
        "name": "scope-set-outside-door",
        "description": "Code sets the origin of its work (who acts, in which role, for which agent) somewhere other than a door, so what it runs no longer answers as the hook, command or request it came from.",
        "rule": "Only the doors set the origin: the receiver for a hook, the console for a command, the router for a viewer request, and the state machine for each agent answering a row event. scope.environment(...) is not flagged: it keeps the origin and changes only the environment.",
        "skill": "stack-machine"
    }
}
