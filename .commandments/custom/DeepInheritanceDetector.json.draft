{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "extendsAny": "Model"
            },
            {
                "ancestors": {
                    "atLeast": 3,
                    "within": "journal.models.*"
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "deep-inheritance",
        "description": "A model sits three or more levels below the project's own classes, where the design allows two: Model, then Scoped, then the model.",
        "rule": "Flatten it: share behaviour through a mixin or a collaborator passed in the constructor instead of another level of parents.",
        "skill": "plain-code-words"
    }
}