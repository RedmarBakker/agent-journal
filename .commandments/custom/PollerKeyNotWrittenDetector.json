{
    "$schema": "../rule.schema.json",
    "engine": "typescript",
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "usePoll",
                    "startPoll",
                    "pollNow",
                    "demand",
                    "pausePoller",
                    "poke"
                ]
            },
            {
                "any": [
                    {
                        "not": {
                            "argument": {
                                "at": 0,
                                "is": "literal"
                            }
                        }
                    },
                    {
                        "argument": {
                            "at": 0,
                            "kind": "TemplateExpression"
                        }
                    }
                ]
            }
        ],
        "reject": [
            {
                "file": "src/web/src/composables/poll.js"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "poller-key-not-written",
        "description": "A poller is started, paused or asked for by a key worked out at runtime, so a reader cannot find which declared poller runs here, and a key made up on the spot can name a poller the table never declared.",
        "rule": "Name the poller by its key written out, a string of two dot-separated segments or more that is one of the entries of the static table in src/web/src/sync/pollers.js; what varies between its runs goes in its params.",
        "skill": "viewer-request-funnel"
    }
}
