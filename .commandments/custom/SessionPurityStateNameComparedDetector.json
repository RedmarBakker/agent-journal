{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "textMatches": "^(${state_names})$"
            },
            {
                "any": [
                    {
                        "of": "parent",
                        "is": "comparison"
                    },
                    {
                        "of": "parent",
                        "all": [
                            {
                                "any": [
                                    {
                                        "kind": "Tuple"
                                    },
                                    {
                                        "kind": "List"
                                    },
                                    {
                                        "kind": "Set"
                                    }
                                ]
                            },
                            {
                                "of": "parent",
                                "is": "comparison"
                            }
                        ]
                    }
                ]
            },
            {
                "of": "closest:comparison",
                "descendant": {
                    "nameIn": [
                        "state",
                        "mode",
                        "MODE"
                    ]
                }
            }
        ],
        "reject": [
            {
                "file": "src/journal/engine/**"
            },
            {
                "file": "src/journal/db/migrations/**"
            }
        ]
    },
    "sin": {
        "name": "state-name-compared",
        "description": "Code decides what to do by comparing against the name of a state or of a work mode, so the behaviour lives outside the state it belongs to.",
        "rule": "Put the behaviour on the state, or on the work mode's state, as a listener or a method the state answers; the engine dispatches by class, never by a name.",
        "skill": "stack-machine"
    }
}
