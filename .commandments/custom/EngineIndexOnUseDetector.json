{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "identifier",
        "where": [
            {
                "nameMatches": "^(cache|lru_cache|cached_property)$"
            },
            {
                "resolvesLike": "functools.*"
            }
        ],
        "reject": [
            {
                "file": "src/journal/http/**"
            },
            {
                "file": "src/journal/db/**"
            },
            {
                "file": "src/journal/repositories/**"
            },
            {
                "file": "src/journal/sync/**"
            },
            {
                "file": "src/journal/console/**"
            },
            {
                "file": "src/journal/launcher/**"
            },
            {
                "file": "src/journal/providers/**"
            },
            {
                "file": "src/journal/support/**"
            },
            {
                "file": "src/journal/hooks/**"
            },
            {
                "file": "src/journal/models/**"
            },
            {
                "file": "src/journal/events/**"
            },
            {
                "file": "src/journal/chat/**"
            },
            {
                "file": "src/journal/runtime.py"
            },
            {
                "file": "src/journal/supervisor_link.py"
            },
            {
                "file": "src/journal/features/*/commands/**"
            },
            {
                "file": "src/journal/features/*/support/**"
            },
            {
                "file": "src/journal/features/*/listeners/**"
            },
            {
                "file": "src/sync_server/**"
            },
            {
                "file": "src/supervisor/**"
            },
            {
                "file": "src/web/**"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "engine-index-on-use",
        "description": "The engine, a state or a conduct works out on first use what it could index once at boot: a functools cache on a method that collects classes, listeners or states fills a store at runtime that nobody owns.",
        "rule": "Index it once at boot, in an object the engine builds and holds, such as ListenerIndex built by StateMachine.index_listeners, and read the index on the way; a method that works it out stays pure, uncached, for the tests that call it directly.",
        "skill": "plain-code-words"
    }
}
