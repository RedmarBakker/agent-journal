{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "name": "Message"
            },
            {
                "descendant": {
                    "name": "SYSTEM"
                }
            }
        ],
        "reject": [
            {
                "file": "src/journal/features/*/listeners/**"
            },
            {
                "file": "src/journal/features/listeners/**"
            },
            {
                "file": "src/journal/models/**"
            },
            {
                "file": "src/journal/chat/moment_cards.py"
            },
            {
                "file": "src/journal/chat/process_cards.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "system-message-outside-listener",
        "description": "A message of the system, a chat mark, is built outside a listener and outside the two card writers.",
        "rule": "A chat mark is written by a listener on the event the change raises, through MomentCards or ProcessCards; a command or support class changes the row that carries the event.",
        "skill": "marks-by-listeners"
    }
}
