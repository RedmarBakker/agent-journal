{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "comparison",
        "where": [
            {
                "declaredBy": "*"
            },
            {
                "any": [
                    {
                        "is": "literal",
                        "of": "child:comparators"
                    },
                    {
                        "nameCase": "upper",
                        "of": "child:comparators"
                    }
                ]
            },
            {
                "repeated": {
                    "atLeast": 3,
                    "files": 2,
                    "eitherWay": true,
                    "by": "owner",
                    "exact": true
                }
            },
            {
                "answeredBy": true
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "answered-field-question",
        "description": "A field of the project's own classes is compared with the same value in three or more functions across two or more files, while a method of its class already asks exactly that.",
        "rule": "Ask the method the field's class already has at every site, instead of the comparison.",
        "skill": "python/repeated-call-helper"
    }
}