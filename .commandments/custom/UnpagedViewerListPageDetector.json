{
    "$schema": "../rule.schema.json",
    "engine": "vue",
    "find": {
        "select": "call",
        "where": [
            {
                "name": "list"
            },
            {
                "argument": {
                    "at": 0,
                    "is": "literal"
                }
            },
            {
                "not": {
                    "argument": {
                        "at": 1,
                        "descendant": {
                            "nameIn": ["limit", "ids"]
                        }
                    }
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "unpaged-viewer-list",
        "description": "The viewer lists a table's rows with no limit and no ids, so the server reads and sends every row of the table on each call.",
        "rule": "Every list call the viewer makes is paged: it names its limit, pageOf(table) from sync/paging.js, or the ids it holds; older rows load a page at a time.",
        "skill": "viewer-lists-paged"
    }
}
