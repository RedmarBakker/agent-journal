{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "textMatches": "^(${event_and_hook_names})$"
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "file": "references.py"
            },
            {
                "file": "hook_type.py"
            },
            {
                "file": "agent_event_type.py"
            },
            {
                "fileMatches": "src/journal/events/agent/"
            },
            {
                "fileMatches": "src/journal/db/migrations/"
            }
        ]
    },
    "sin": {
        "name": "raw-event-name",
        "description": "A hook or an agent event is named by a raw string such as \"SessionStarted\".",
        "rule": "Name a hook or an event by its reference in journal.references: hooks.SESSION_START, events.SESSION_STARTED.",
        "skill": "plain-code-words"
    }
}
