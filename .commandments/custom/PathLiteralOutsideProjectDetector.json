{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "textMatches": "^(/tmp|/var|/etc|/Users|/home|/private|~)(/|$)"
            },
            {
                "fileMatches": "(^|/)(journal|sync_server|supervisor)/"
            }
        ],
        "reject": [
            {
                "file": "src/journal/launcher/**"
            },
            {
                "file": "src/journal/features/plugins/support/plugin_folders.py"
            },
            {
                "file": "src/journal/features/shell/**"
            },
            {
                "file": "src/journal/providers/**"
            },
            {
                "file": "src/journal/features/secrets/support/secrets_data_reader.py"
            },
            {
                "file": "src/journal/support/part.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "path-literal-outside-project",
        "description": "A path outside the project is written out: /tmp, /var, a home folder or a ~ path. The sockets the launcher and the plugins open stay in /tmp, whose paths are short enough for a socket, the providers name their own settings in the home, and the shell and the secrets read the paths an agent's command names; nothing else is written there.",
        "rule": "Keep the file under the project's .journal folder.",
        "skill": "python/fix-at-the-source"
    }
}
