{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "judges": [
        "tests/stories"
    ],
    "find": {
        "select": "literal",
        "where": [
            {
                "file": "tests/stories/**"
            },
            {
                "textMatches": "^[0-9][0-9_.]*$"
            }
        ],
        "reject": [
            {
                "textMatches": "^[01]$"
            },
            {
                "file": "tests/stories/builder/**"
            },
            {
                "file": "tests/stories/fixtures/**"
            },
            {
                "file": "tests/stories/conftest.py"
            },
            {
                "file": "tests/stories/test_*.py"
            },
            {
                "inside": {
                    "all": [
                        {
                            "is": "call"
                        },
                        {
                            "name": "setting"
                        }
                    ]
                }
            }
        ]
    },
    "sin": {
        "description": "A story writes a raw number.",
        "name": "story-number",
        "rule": "Take every number a story depends on from a setting it declares with @setting and reads with story.setting(option), or from a named constant of the code.",
        "skill": "tests-drive-the-real-path"
    }
}
