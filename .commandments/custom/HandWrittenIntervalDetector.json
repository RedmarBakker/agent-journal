{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "comparison",
        "where": [
            {
                "descendant": {
                    "nameMatches": "(seconds|_at$|uses|edits|runs|ticks|^time$)"
                }
            },
            {
                "descendant": {
                    "nameMatches": "^([A-Z][A-Z0-9_]{2,}|integer|decimal)$"
                }
            }
        ],
        "reject": [
            {
                "file": "src/journal/http/**"
            },
            {
                "file": "src/journal/db/**"
            },
            {
                "file": "src/journal/repositories/**"
            },
            {
                "file": "src/journal/sync/**"
            },
            {
                "file": "src/journal/console/**"
            },
            {
                "file": "src/journal/launcher/**"
            },
            {
                "file": "src/journal/providers/**"
            },
            {
                "file": "src/journal/support/**"
            },
            {
                "file": "src/journal/hooks/**"
            },
            {
                "file": "src/journal/models/**"
            },
            {
                "file": "src/journal/events/**"
            },
            {
                "file": "src/journal/chat/**"
            },
            {
                "file": "src/journal/runtime.py"
            },
            {
                "file": "src/journal/supervisor_link.py"
            },
            {
                "file": "src/journal/features/*/commands/**"
            },
            {
                "file": "src/journal/features/*/support/**"
            },
            {
                "file": "src/journal/features/*/listeners/**"
            },
            {
                "file": "src/sync_server/**"
            },
            {
                "file": "src/supervisor/**"
            },
            {
                "file": "src/web/**"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "hand-written-interval",
        "description": "A state, a conduct or a job waits out a span by hand: a counter compared with a setting or a constant, a % for every Nth time, or a subtraction of times compared with a number of seconds.",
        "rule": "Wait it out with Timeout from support/timeout.py: Timeout.edits(n), tool_uses(n), seconds(n) or minutes(n), started at the moment counted from, asked has_passed or is_elapsed, and combined with spans in other units when it fires on whichever comes first; a reminder every Nth time is a Timeout started again each time it fires.",
        "skill": "plain-code-words"
    }
}
