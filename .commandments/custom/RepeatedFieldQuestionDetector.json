{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "comparison",
        "where": [
            {
                "declaredBy": "*"
            },
            {
                "any": [
                    {
                        "is": "literal",
                        "of": "child:comparators"
                    },
                    {
                        "nameCase": "upper",
                        "of": "child:comparators"
                    }
                ]
            },
            {
                "repeated": {
                    "atLeast": 3,
                    "files": 2,
                    "eitherWay": true,
                    "by": "owner",
                    "exact": true
                }
            },
            {
                "answeredBy": false
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "repeated-field-question",
        "description": "A field of the project's own classes is compared with the same value, the same way, in three or more functions across two or more files, and no method of its class asks it yet.",
        "rule": "Name the question once, as a method of the class that declares the field, and ask that method at every site.",
        "skill": "python/repeated-call-helper"
    }
}