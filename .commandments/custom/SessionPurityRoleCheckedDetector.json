{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "member-access",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "name": "is_helper"
                            },
                            {
                                "of": "parent",
                                "is": "call"
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "of": "child:value",
                                "name": "AgentRole"
                            },
                            {
                                "inside": {
                                    "is": "comparison"
                                }
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "file": "src/journal/support/agent_role.py"
            },
            {
                "file": "src/journal/http/controllers/hooks.py"
            },
            {
                "file": "src/journal/hooks/translation.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "session-purity-role-checked",
        "description": "Code asks which role an agent has, the main agent, a worker, a reviewer, a verifier or a subagent, and branches on it, after the hook's entry point has already scoped the engine on that role.",
        "rule": "The hook's entry point sets the role once and the engine runs scoped on it: put the behaviour on the state or conduct in force for that role, so no code asks the role again.",
        "skill": "stack-machine"
    }
}
