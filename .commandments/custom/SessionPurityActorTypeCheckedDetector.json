{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "member-access",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "nameMatches": "^is_(user|subagent|agent|desk_user|main_agent|unnamed_agent|worker|verifier|reviewer|plugin)$"
                            },
                            {
                                "of": "parent",
                                "is": "call"
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "name": "actor_type"
                            },
                            {
                                "of": "parent",
                                "is": "comparison"
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "of": "child:value",
                                "name": "ActorType"
                            },
                            {
                                "inside": {
                                    "is": "comparison"
                                }
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "file": "src/journal/support/actor.py"
            },
            {
                "file": "src/journal/support/caller.py"
            },
            {
                "file": "src/journal/support/actor_type.py"
            },
            {
                "file": "src/journal/http/controllers/hooks.py"
            },
            {
                "file": "src/journal/hooks/translation.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "session-purity-actor-type-checked",
        "description": "Code asks what type of actor or caller it serves, a user, an agent, a worker, a reviewer or a plugin, and branches on it, after the entry point has already scoped the engine on that actor.",
        "rule": "The entry point sets the actor once and the engine runs scoped on it: let the state, conduct or command in force for that actor carry the behaviour, so no code asks the actor's type again.",
        "skill": "stack-machine"
    }
}
