{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "name": "home"
                            },
                            {
                                "of": "child:func",
                                "all": [
                                    {
                                        "is": "member-access"
                                    },
                                    {
                                        "of": "child:value",
                                        "name": "Path"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "name": "expanduser"
                    },
                    {
                        "name": "gettempdir"
                    },
                    {
                        "all": [
                            {
                                "of": "child:func",
                                "all": [
                                    {
                                        "is": "member-access"
                                    },
                                    {
                                        "of": "child:value",
                                        "name": "tempfile"
                                    }
                                ]
                            },
                            {
                                "not": {
                                    "descendant": {
                                        "name": "dir"
                                    }
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "fileMatches": "(^|/)(journal|sync_server|supervisor)/"
            }
        ],
        "reject": [
            {
                "file": "src/journal/config.py"
            },
            {
                "file": "src/journal/launcher/**"
            },
            {
                "file": "src/journal/providers/**"
            },
            {
                "file": "src/journal/support/private_folder.py"
            },
            {
                "file": "src/journal/features/secrets/support/secret_run.py"
            },
            {
                "file": "src/journal/features/updates/support/release_check_memory.py"
            },
            {
                "file": "src/journal/features/sharing/support/tunler.py"
            },
            {
                "file": "src/journal/console/commands/setup_command.py"
            },
            {
                "file": "src/journal/engine/support/menu_answers.py"
            },
            {
                "file": "src/journal/support/docx_export.py"
            },
            {
                "file": "src/journal/features/shell/**"
            },
            {
                "file": "src/journal/support/part.py"
            },
            {
                "file": "src/journal/support/tool_call.py"
            },
            {
                "file": "src/journal/support/file_read.py"
            },
            {
                "file": "src/journal/features/workers/workers_conduct.py"
            },
            {
                "file": "src/journal/features/workers/support/test_run_folder.py"
            },
            {
                "file": "src/journal/features/secrets/support/secrets_data.py"
            },
            {
                "file": "src/journal/features/secrets/support/secrets_data_reader.py"
            },
            {
                "file": "src/journal/features/messages/support/message_files.py"
            },
            {
                "file": "src/journal/features/docs/commands/doc_command.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "path-outside-project",
        "description": "Code reaches a path outside the project: the home folder, a ~ path expanded, or the system's temporary folder. The journal reads and writes inside the repository; the places that must reach outside are named as this rule's exceptions: the launcher, the providers' homes, the private folder of keys and secrets with its secret runs, the machine's status and release memory, the tunnel program, the journal command setup installs, a provider asked in a neutral folder, the document converter's throwaway folder, and the paths an agent's command or the user's own words name.",
        "rule": "Keep the file under the project's .journal folder: its runtime folder for what lasts a run, a folder of its own beside what it serves for the rest.",
        "skill": "python/fix-at-the-source"
    }
}
