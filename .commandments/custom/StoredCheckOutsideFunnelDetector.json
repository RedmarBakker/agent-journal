{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "function",
        "where": [
            {
                "fileMatches": "(^|/)journal/features/[^/]+/(listeners|support)/"
            },
            {
                "calls": {
                    "all": [
                        {
                            "name": "save"
                        },
                        {
                            "argument": {
                                "at": 0,
                                "any": [
                                    {
                                        "nameIn": [
                                            "Message",
                                            "Entry",
                                            "Link",
                                            "ScheduledJob"
                                        ]
                                    },
                                    {
                                        "descendant": {
                                            "nameIn": [
                                                "Message",
                                                "Entry",
                                                "Link",
                                                "ScheduledJob"
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "descendant": {
                    "all": [
                        {
                            "is": "comparison"
                        },
                        {
                            "any": [
                                {
                                    "all": [
                                        {
                                            "operator": "not in"
                                        },
                                        {
                                            "not": {
                                                "of": "child:left",
                                                "is": "literal"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "all": [
                                        {
                                            "operator": "=="
                                        },
                                        {
                                            "inside": {
                                                "any": [
                                                    {
                                                        "kind": "GeneratorExp"
                                                    },
                                                    {
                                                        "kind": "ListComp"
                                                    },
                                                    {
                                                        "kind": "SetComp"
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "descendant": {
                                                "nameIn": [
                                                    "text",
                                                    "data"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "calls": {
                    "nameIn": [
                        "sent_with",
                        "recorded",
                        "posted",
                        "keyed",
                        "with_key",
                        "is_shown",
                        "linked"
                    ]
                }
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "stored-check-outside-funnel",
        "description": "A listener or support class records a row from an outside source after deciding by its own check whether it is stored already, a set of texts it has seen or a comparison of texts or fields, so every recorder of that kind of row decides it in its own way and an edit or a repeat of the row breaks each one differently.",
        "rule": "Give the row its key where it is built, VoiceKey for a message, and store it through the funnel for its kind: Messages.recorded or Messages.sent_with for a message, ProcessCards.show or MomentCards.is_shown for a card by its key, the repository's own read by key for any other row.",
        "skill": "rows-through-their-repository"
    }
}
