{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "member-access",
        "where": [
            {
                "nameIn": [
                    "agent",
                    "agent_row"
                ]
            },
            {
                "descendant": {
                    "nameIn": [
                        "event",
                        "caller",
                        "scope"
                    ]
                }
            },
            {
                "inside": {
                    "all": [
                        {
                            "is": "call"
                        },
                        {
                            "name": "save"
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "inside": {
                    "all": [
                        {
                            "is": "call"
                        },
                        {
                            "nameIn": [
                                "newest_row",
                                "rewritten",
                                "touched"
                            ]
                        }
                    ]
                }
            },
            {
                "file": "tests/**"
            }
        ]
    },
    "sin": {
        "name": "stale-agent-save",
        "description": "The agent row an event, a caller or the scope carried from its door is saved back, though another listener may have changed the row since, so its newer stack or facts are written over.",
        "rule": "Change the agent row through agents.rewritten or agents.touched, which read it by its id in the transaction, or read it again with agents.newest_row before deciding.",
        "skill": "rows-through-their-repository"
    }
}
