{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "member-access",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "nameIn": [
                                    "hook_type",
                                    "event_type",
                                    "entry_type"
                                ]
                            },
                            {
                                "of": "parent",
                                "is": "comparison"
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "of": "child:value",
                                "name": "HookType"
                            },
                            {
                                "inside": {
                                    "is": "comparison"
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "nameMatches": "^is_(pre_tool_use|post_tool_use|stop|session_start|session_end|prompt|researcher)$"
                            },
                            {
                                "of": "parent",
                                "is": "call"
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "file": "src/journal/repositories/**"
            },
            {
                "file": "src/journal/providers/**"
            },
            {
                "file": "src/journal/support/hook.py"
            },
            {
                "file": "src/journal/support/hook_type.py"
            },
            {
                "file": "src/journal/engine/**"
            },
            {
                "file": "src/journal/http/controllers/hooks.py"
            },
            {
                "file": "src/journal/hooks/translation.py"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "session-purity-hook-kind-compared",
        "description": "Code decides what to do by asking which hook fired, or an event's or an entry's kind, so the behaviour is chosen by a name instead of by the event's class.",
        "rule": "The hook's translation turns its kind into an event once: listen to that event's class with an on_<moment> method or a Listener of that type; to ask what happened before, name the question in the repository that holds the entries.",
        "skill": "stack-machine"
    }
}
