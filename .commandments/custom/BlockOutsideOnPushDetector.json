{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "name": "Block"
            }
        ],
        "reject": [
            {
                "inside": {
                    "all": [
                        {
                            "is": "function"
                        },
                        {
                            "name": "on_push"
                        }
                    ]
                }
            },
            {
                "file": "tests/**"
            }
        ]
    },
    "sin": {
        "name": "block-outside-on-push",
        "description": "A Block is built outside on_push, the one hook that may refuse a push.",
        "rule": "Refuse a push in on_push with Block(nudge); everywhere else answer refuse(nudge) on the state.",
        "skill": "stack-machine"
    }
}
