{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Command table",
    "description": "What a single shell command is and does: each program's base, the subcommands and options that change it, the wrappers that run another command, and the forms whose meaning the line cannot tell.",
    "type": "object",
    "required": ["about", "version", "kinds", "effects", "redirects", "interpreted", "unknown", "scripts", "wrappers", "programs"],
    "additionalProperties": false,
    "properties": {
        "about": {"type": "string"},
        "version": {"type": "integer"},
        "kinds": {"type": "array", "items": {"type": "string"}},
        "effects": {"type": "array", "items": {"type": "string"}},
        "redirects": {
            "type": "object",
            "required": ["writes", "except", "effects"],
            "properties": {
                "writes": {"type": "array", "items": {"type": "string"}},
                "except": {"type": "array", "items": {"type": "string"}},
                "effects": {"type": "array", "items": {"type": "string"}}
            }
        },
        "interpreted": {"type": "object", "required": ["note"]},
        "unknown": {"$ref": "#/$defs/classification"},
        "scripts": {"type": "object", "description": "Rows for a script the table knows by its file name, keyed by a pattern of that name.", "additionalProperties": {"$ref": "#/$defs/row"}},
        "wrappers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/wrapper"}},
        "programs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/program"}}
    },
    "$defs": {
        "classification": {
            "type": "object",
            "required": ["kind", "effects"],
            "properties": {
                "kind": {"type": "string"},
                "effects": {"type": "array", "items": {"type": "string"}},
                "uncertain": {"type": "boolean"},
                "note": {"type": "string"},
                "dialects": {"type": "string"},
                "runs": {"type": "string"}
            }
        },
        "row": {
            "type": "object",
            "description": "A classification, or a pointer to another row of the same level by same_as, with the rows below it.",
            "properties": {
                "kind": {"type": "string"},
                "effects": {"type": "array", "items": {"type": "string"}},
                "uncertain": {"type": "boolean"},
                "interpreted": {"type": "boolean"},
                "runs_script_file": {"type": "boolean"},
                "starts_processes": {"type": "boolean"},
                "redirected_label": {"type": "string"},
                "label": {"type": "string"},
                "bare_label": {"type": "string"},
                "note": {"type": "string"},
                "dialects": {"type": "string"},
                "runs": {"type": "string"},
                "same_as": {"type": "string"},
                "subcommands": {"type": "object", "additionalProperties": {"$ref": "#/$defs/row"}},
                "modifiers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/row"}}
            },
            "additionalProperties": false
        },
        "program": {
            "type": "object",
            "properties": {
                "base": {"$ref": "#/$defs/row"},
                "same_as": {"type": "string"},
                "value_flags": {"type": "array", "items": {"type": "string"}},
                "kind": {"type": "string"},
                "effects": {"type": "array", "items": {"type": "string"}},
                "uncertain": {"type": "boolean"},
                "interpreted": {"type": "boolean"},
                "runs_script_file": {"type": "boolean"},
                "starts_processes": {"type": "boolean"},
                "redirected_label": {"type": "string"},
                "label": {"type": "string"},
                "bare_label": {"type": "string"},
                "runs": {"type": "string"},
                "subcommands": {"type": "object", "additionalProperties": {"$ref": "#/$defs/row"}},
                "modifiers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/row"}}
            },
            "additionalProperties": false
        },
        "wrapper": {
            "type": "object",
            "properties": {
                "same_as": {"type": "string"},
                "value_flags": {"type": "array", "items": {"type": "string"}},
                "leading_values": {"type": "integer"},
                "assignments": {"type": "boolean"},
                "subcommands": {"type": "array", "items": {"type": "string"}},
                "until": {"type": "string"},
                "code_contains": {"type": "string"},
                "lookup_flags": {"type": "array", "items": {"type": "string"}},
                "limits_time": {"type": "boolean"}
            },
            "additionalProperties": false
        }
    }
}
