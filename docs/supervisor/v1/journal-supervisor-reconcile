#!/bin/sh
set -eu

. /opt/journal-supervisor/bin/journal-supervisor-environment

case_wake_file="${JOURNAL_SUPERVISOR_STATE_DIR%/*}/journal-supervisor-case-wake"
if [ -r "$case_wake_file" ]; then
    case_wake=$(cat "$case_wake_file")
    case "$case_wake" in
        scheduled|quiet)
            exec /opt/journal-supervisor/bin/journal-supervisor-bridge reconcile
            ;;
        event:*:PSU-[0-9][0-9])
            event_kind=${case_wake#event:}
            event_kind=${event_kind%:*}
            case "$event_kind" in
                ''|*[!a-z_]*)
                    echo "the staged supervisor case has an unsupported event wake kind" >&2
                    exit 2
                    ;;
            esac
            event_id=${case_wake##*:}
            exec /opt/journal-supervisor/bin/journal-supervisor-bridge reconcile event "$event_kind" "$event_id"
            ;;
        *)
            echo "the staged supervisor case has an unsupported wake kind" >&2
            exit 2
            ;;
    esac
fi
exec /opt/journal-supervisor/bin/journal-supervisor-bridge reconcile
