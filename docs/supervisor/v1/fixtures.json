  "semantic_negative_cases": [
    {
      "case": "future_phase",
      "difference": "Action diagnostic phase differs from the enrolled and actual current phase",
      "expected": "conflicted; no domain writes or notification"
    },
    {
      "case": "owner_checkpoint_in_auto_mode",
      "difference": "Reserved checkpoint exists even though tasks.auto is true",
      "expected": "needs_owner/ineligible; never cross checkpoint"
    },
    {
      "case": "busy_driver",
      "difference": "Bound ordinary driver has a started task",
      "expected": "Do not interrupt/reassign; observe and deliver only at a legitimate safe free moment"
    },
    {
      "case": "wrong_tenant_or_fallback",
      "difference": "Bad service token or credential-A references row-B/environment-B",
      "expected": "401/403 before Identity fallback; no row/evidence disclosure"
    },
    {
      "case": "optional_category",
      "difference": "Sequence, phrase nudge or reminder-setting operation is supplied",
      "expected": "rejected unsupported capability; no partial writes"
    },
    {
      "case": "duplicate_committed_reply",
      "difference": "100 identical deliveries after successful commit but lost response",
      "expected": "One canonical receipt and existing row IDs; no second domain mutation"
    },
    {
      "case": "changed_action_intent",
      "difference": "Same action ID with different normalized operations or preconditions",
      "expected": "rejected intent mismatch; new action requires journal admission"
    },
    {
      "case": "restore_old_epoch",
      "difference": "Callback carries old installation epoch after backup restore",
      "expected": "rejected even when old receipt is retained; owner may inspect receipt separately"
    },
    {
      "case": "unknown_runtime_bound",
      "difference": "Provider requests/token/retry ceiling or usage cannot be attested",
      "expected": "admission skip unknown_cost; no model call or domain write"
    },
    {
      "case": "mcp_unavailable",
      "difference": "Declared MCP server is offline or missing its tools",
      "expected": "No built-in exec/browser/file/message/admin tools become available; reconcile observes transport fault without expanding policy"
    },
    {
      "case": "diagnostic_close_at_reserved_checkpoint",
      "difference": "The normal driver finishes the diagnostic as the current phase ends while tasks.auto is true",
      "expected": "Existing normal assignment honors the enrolled owner reservation and cannot cross the checkpoint; no manual intervention was needed to take diagnosis, but crossing still awaits owner decision"
    }
  ],
