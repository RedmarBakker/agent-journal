{
  "name": "agent-journal-supervisor-v1",
  "services": {
    "writer": {
      "profiles": ["authorized-staging"],
      "image": "agent-journal-supervisor-writer:${PROFILE_REVISION:?set PROFILE_REVISION to the reviewed source commit}",
      "restart": "unless-stopped",
      "environment": {
        "JOURNAL_ROOT": "/data/project",
        "JOURNAL_HOST": "127.0.0.1",
        "JOURNAL_PORT": "8421",
        "JOURNAL_OWNER_ACCESS_HOST": "10.76.10.10",
        "JOURNAL_OWNER_ACCESS_PORT": "8423",
        "JOURNAL_SUPERVISOR_HOST": "10.76.20.10",
        "JOURNAL_SUPERVISOR_PORT": "8422",
        "JOURNAL_SUPERVISOR_TLS_CERT_FILE": "/run/secrets/writer_supervisor_tls_cert",
        "JOURNAL_SUPERVISOR_TLS_KEY_FILE": "/run/secrets/writer_supervisor_tls_key",
        "GIT_NAME": "Journal supervisor pilot",
        "GIT_EMAIL": "journal-pilot@localhost",
        "JOURNAL_CODEX_HOME": "/var/lib/journal-codex",
        "JOURNAL_PLAN_DRIVER_SOCKET": "/run/journal-plan-driver.sock"
      },
      "volumes": ["writer_state:/data", "codex_driver_state:/var/lib/journal-codex", "supervisor_hints:/var/lib/journal-supervisor/hints"],
      "secrets": [
        {"source": "writer_supervisor_tls_cert", "target": "writer_supervisor_tls_cert"},
        {"source": "writer_supervisor_tls_key", "target": "writer_supervisor_tls_key"}
      ],
      "ports": ["127.0.0.1:18440:8423"],
      "expose": ["8422"],
      "networks": {
        "journal_management": {"ipv4_address": "10.76.10.10"},
        "gateway_link": {"ipv4_address": "10.76.20.10"},
        "provider_egress": {}
      },
      "read_only": true,
      "tmpfs": ["/tmp", "/run:mode=1777"],
      "cap_drop": ["ALL"],
      "cap_add": ["SETUID", "SETGID", "SETPCAP"],
      "security_opt": ["no-new-privileges:true"],
      "healthcheck": {
        "test": ["CMD-SHELL", "curl -fsS http://127.0.0.1:8421/journal/health"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "60s"
      },
      "logging": {"driver": "local", "options": {"max-size": "10m", "max-file": "5"}}
    },
    "gateway": {
      "profiles": ["authorized-staging"],
      "image": "agent-journal-supervisor-gateway:${PROFILE_REVISION:?set PROFILE_REVISION to the reviewed source commit}",
      "user": "1000:1000",
      "group_add": ["10030"],
      "working_dir": "/app",
      "entrypoint": ["/bin/sh", "/run/pilot/gateway-entrypoint.sh"],
      "configs": [
        {"source": "gateway_entrypoint", "target": "/run/pilot/gateway-entrypoint.sh", "mode": "0555"},
        {"source": "openclaw_config", "target": "/home/node/.openclaw/openclaw.json", "mode": "0444"}
      ],
      "environment": {
        "HOME": "/home/node",
        "OPENCLAW_GATEWAY_PORT": "18789",
        "JOURNAL_SUPERVISOR_ADMISSION_URL": "https://writer:8422",
        "JOURNAL_SUPERVISOR_TLS_CA_FILE": "/run/secrets/writer_supervisor_tls_ca"
      },
      "secrets": [
        {"source": "supervisor_anthropic_api_key", "target": "supervisor_anthropic_api_key"},
        {"source": "openclaw_hook_token", "target": "openclaw_hook_token"},
        {"source": "journal_supervisor_credential", "target": "journal_supervisor_credential"},
        {"source": "writer_supervisor_tls_ca", "target": "writer_supervisor_tls_ca"}
      ],
      "volumes": ["gateway_state:/home/node/.openclaw", "supervisor_hints:/var/lib/journal-supervisor/hints:ro"],
      "expose": ["18789"],
      "networks": {
        "gateway_link": {"ipv4_address": "10.76.20.20"},
        "provider_egress": {}
      },
      "read_only": true,
      "tmpfs": ["/tmp"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "healthcheck": {
        "test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:18789/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "60s"
      },
      "restart": "unless-stopped"
    },
    "backup": {
      "profiles": ["authorized-staging"],
      "image": "restic/restic@sha256:8f5a62b422a2cb1277ea0dd6e826fe1acf649e5b9f02d60e5268d5fd1976255a",
      "user": "10005:10005",
      "entrypoint": ["/bin/sh", "/run/pilot/backup-entrypoint.sh"],
      "configs": [{"source": "backup_entrypoint", "target": "/run/pilot/backup-entrypoint.sh", "mode": "0555"}],
      "environment": {
        "TENANT_ID": "${TENANT_ID:?set this one-tenant installation id}",
        "BACKUP_EVERY": "900",
        "RESTIC_PASSWORD_FILE": "/run/secrets/restic_password",
        "RESTIC_REPOSITORY_FILE": "/run/secrets/restic_repository",
        "AWS_SHARED_CREDENTIALS_FILE": "/run/secrets/backup_object_store_credentials"
      },
      "secrets": [
        {"source": "restic_password", "target": "restic_password"},
        {"source": "restic_repository", "target": "restic_repository"},
        {"source": "backup_object_store_credentials", "target": "backup_object_store_credentials"}
      ],
      "volumes": ["writer_state:/data:ro", "gateway_state:/gateway:ro", "restore_candidate:/restore-candidate"],
      "networks": ["backup_egress"],
      "read_only": true,
      "tmpfs": ["/tmp"],
      "cap_drop": ["ALL"],
      "cap_add": ["DAC_READ_SEARCH"],
      "security_opt": ["no-new-privileges:true"],
      "restart": "unless-stopped"
    }
  },
  "networks": {
    "journal_management": {"internal": true, "ipam": {"config": [{"subnet": "10.76.10.0/24"}]}},
    "gateway_link": {"internal": true, "ipam": {"config": [{"subnet": "10.76.20.0/24"}]}},
    "provider_egress": {},
    "backup_egress": {}
  },
  "volumes": {
    "writer_state": {},
    "codex_driver_state": {},
    "gateway_state": {
      "driver": "local",
      "driver_opts": {"type": "none", "o": "bind", "device": "${GATEWAY_STATE_PATH:?pre-create a tenant-specific directory owned by uid 1000 gid 10030 mode 0750}"}
    },
    "supervisor_hints": {
      "driver": "local",
      "driver_opts": {"type": "tmpfs", "device": "tmpfs", "o": "uid=10001,gid=10030,mode=2750,size=4m"}
    },
    "restore_candidate": {
      "driver": "local",
      "driver_opts": {"type": "none", "o": "bind", "device": "${RESTORE_CANDIDATE_PATH:?pre-create an empty tenant-specific directory owned by uid 10005}"}
    }
  },
  "configs": {
    "gateway_entrypoint": {"file": "./gateway-entrypoint.sh"},
    "openclaw_config": {"file": "${OPENCLAW_CONFIG_FILE:?set the task-111 validated, owner-approved config}"},
    "backup_entrypoint": {"file": "./backup-entrypoint.sh"}
  },
  "secrets": {
    "supervisor_anthropic_api_key": {"file": "${TENANT_SECRET_DIR:?set the root-owned tenant secret directory}/supervisor_anthropic_api_key"},
    "openclaw_hook_token": {"file": "${TENANT_SECRET_DIR:?set the root-owned tenant secret directory}/openclaw_hook_token"},
    "journal_supervisor_credential": {"file": "${TENANT_SECRET_DIR:?set the root-owned tenant secret directory}/journal_supervisor_credential"},
    "writer_supervisor_tls_cert": {"file": "${TENANT_SECRET_SOURCE_DIR:?set the root-owned tenant secret source directory}/writer_supervisor_tls_cert"},
    "writer_supervisor_tls_key": {"file": "${TENANT_SECRET_SOURCE_DIR:?set the root-owned tenant secret source directory}/writer_supervisor_tls_key"},
    "writer_supervisor_tls_ca": {"file": "${TENANT_SECRET_SOURCE_DIR:?set the root-owned tenant secret source directory}/writer_supervisor_tls_ca"},
    "restic_password": {"file": "${TENANT_SECRET_DIR:?set the root-owned tenant secret directory}/restic_password"},
    "restic_repository": {"file": "${TENANT_SECRET_DIR:?set the root-owned tenant secret directory}/restic_repository"},
    "backup_object_store_credentials": {"file": "${TENANT_SECRET_DIR:?set the root-owned tenant secret directory}/backup_object_store_credentials"}
  }
}
