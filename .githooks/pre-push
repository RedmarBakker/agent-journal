#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
release_tag=""
while read -r local_ref local_sha remote_ref remote_sha; do
    # an all-zero local sha means the ref is being deleted, and deleting a badly named tag is the cure, not the disease
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    case "$remote_ref" in
        refs/tags/[0-9]*)
            echo "a release tag is named v<version>, such as v${remote_ref#refs/tags/}: the updater fetches refs/tags/v<version>" >&2
            exit 1
            ;;
        refs/tags/v*) release_tag="${remote_ref#refs/tags/}" ;;
    esac
done
# the update matrix ran before the tag and wrote the release into update_steps.json, as a step or as no step, so the
# tag's own tree must name its version: the updater reads that file from the tag beside install.sh
if [ -n "$release_tag" ]; then
    git show "$release_tag:update_steps.json" 2>/dev/null |
        python3 -c 'import json, sys; sys.exit(sys.argv[1] not in json.load(sys.stdin))' "${release_tag#v}" 2>/dev/null ||
        { echo "push refused: the update_steps.json of $release_tag does not name ${release_tag#v} as a step or as no step; run python3 scripts/suite.py --update-matrix before tagging and commit the file it writes" >&2; exit 1; }
fi
python3 scripts/checks/viewer_built.py
# every route and hook kind is timed against the saved full project in one process, and one over its budget, or a run past
# its time limit, refuses the push; a commit is never refused for it, so no work is lost
perl -e 'alarm shift; exec @ARGV' 300 python3 -m pytest -q -p no:warnings tests/route_points_run.py ||
    { echo "push refused: a route or hook spent more than its 30 points, or the run passed 300 seconds (python3 -m pytest -q tests/route_points_run.py)" >&2; exit 1; }
