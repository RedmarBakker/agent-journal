#!/bin/sh
# A release commit, whose message starts with its number (4.55.3: ...), carries that number in src/journal/version.py:
# when the file says another, it is set to the message's number and the commit amended with it, so a release never
# ships the wrong version.
set -eu

cd "$(git rev-parse --show-toplevel)"
number=$(git log -1 --format=%s | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\): .*/\1/p')
[ -n "$number" ] || exit 0
file=src/journal/version.py
written=$(sed -n 's/^VERSION = "\(.*\)"$/\1/p' "$file")
[ "$written" = "$number" ] && exit 0
sed -i.bak "s/^VERSION = \".*\"$/VERSION = \"$number\"/" "$file" && rm -f "$file.bak"
git add "$file"
git commit --amend --no-edit --no-verify -q
echo "the release commit named $number while $file said $written: the file now says $number, in the same commit" >&2
