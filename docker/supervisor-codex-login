#!/bin/sh
set -eu
: "${JOURNAL_CODEX_HOME:?set JOURNAL_CODEX_HOME}"

if [ "$#" -ne 0 ]; then
    echo "supervisor-codex-login accepts no arguments" >&2
    exit 2
fi
if [ "$(id -u)" -ne 0 ]; then
    echo "supervisor-codex-login must run as the writer container root" >&2
    exit 2
fi

mkdir -p "$JOURNAL_CODEX_HOME"
chown journal:journal "$JOURNAL_CODEX_HOME"
chmod 0700 "$JOURNAL_CODEX_HOME"
exec setpriv --reuid journal --regid journal --init-groups env CODEX_HOME="$JOURNAL_CODEX_HOME" codex login --device-auth
