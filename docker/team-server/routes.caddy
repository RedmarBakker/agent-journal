# The team server's paths go to the sync server, but only with the journal's protocol header, a request without it
# answered 404 before it reaches the server; every other path is answered 404 too.
@library path /login /accept /install /invite /devices /devices/* /people /people/* /password /backups /library /items /items/*
handle @library {
	@unmarked not header X-Journal-Protocol *
	respond @unmarked 404
	reverse_proxy 127.0.0.1:8470
}
handle {
	respond 404
}
